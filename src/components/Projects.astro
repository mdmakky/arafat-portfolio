---
import { projects } from '../data/site';
const arrow = '<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';
---
<div id="work">
  <h2>Things I've built</h2>
  {projects.map((p) => {
    const story = p.slug ? `/work/${p.slug}` : null;
    return (
      <article>
        <h3>{story ? <a href={story}>{p.name}</a> : <a href={p.url} target="_blank" rel="noopener">{p.name}</a>}</h3>
        <p class="sub">{p.tagline}</p>
        <p set:html={p.body} />
        <div class="links">
          {story && <a class="more" href={story}>How I built it <Fragment set:html={arrow} /></a>}
          <a class="more" href={p.url} target="_blank" rel="noopener">{p.cta} <Fragment set:html={arrow} /></a>
        </div>
      </article>
    );
  })}
</div>

<style>
  article { margin-bottom: 48px; }
  h3 { font: 700 22px/1.3 var(--sans); margin: 0; letter-spacing: -.01em; }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--accent2); }
  .sub { color: var(--accent2); font-weight: 500; margin: 2px 0 10px; font-size: 17px; }
  p { color: var(--soft); margin: 0 0 12px; max-width: 62ch; }
  p :global([lang="bn"]) { font-family: var(--bangla); }
  p :global(code) { font: 500 .85em var(--mono); background: var(--pill); border: 1px solid var(--pillb); border-radius: 5px; padding: 1px 6px; }
  .links { display: flex; gap: 22px; flex-wrap: wrap; }
  .more { font-weight: 700; font-size: 15px; text-decoration: none; display: inline-flex; gap: 6px; align-items: center; }
  .more:hover { color: var(--accent2); }
</style>
