---
import gh from '../data/github.json';

// 0..4 intensity levels; sqrt so one huge day does not wash out the rest
const max = Math.max(...gh.weeks.flat().map(([, n]) => n as number));
const level = (n: number) => (n === 0 ? 0 : Math.min(4, Math.ceil(Math.sqrt(n / max) * 4)));
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<section class="gh" aria-labelledby="gh-h">
  <div class="head">
    <h2 id="gh-h">On GitHub</h2>
    <a class="handle" href="https://github.com/mdmakky" target="_blank" rel="noopener">@mdmakky <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></a>
  </div>
  <p class="lead"><b>{gh.total} contributions</b> in the last year, across {gh.publicRepos} public repositories.</p>

  <div class="scroll">
    <div class="cal" role="img" aria-label={`Contribution calendar: ${gh.total} contributions in the last year`}>
      {gh.weeks.map((week) => (
        <div class="wk">
          {week.map(([d, n]) => <i class={`l${level(n as number)}`} title={`${n} on ${fmt(d as string)}`} />)}
        </div>
      ))}
    </div>
  </div>

  <h3>Public repos by language</h3>
  <div class="bar" aria-hidden="true">
    {gh.languages.map((l) => <span style={`width:${l.pct}%;background:${l.color}`} />)}
  </div>
  <ul class="legend">
    {gh.languages.map((l) => <li><i style={`background:${l.color}`} />{l.name} <span>{l.repos}</span></li>)}
  </ul>
  <p class="note">Snapshot from {fmt(gh.updated)}.</p>
</section>

<style>
  .gh { border-top: 1px solid var(--pillb); padding-top: 56px; margin-top: 8px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .head h2 { margin: 0; }
  .handle { font-weight: 700; font-size: 15px; text-decoration: none; display: inline-flex; gap: 6px; align-items: center; }
  .lead { color: var(--soft); margin: 14px 0 22px; }
  .lead b { color: var(--fg); }
  .scroll { overflow-x: auto; padding-bottom: 6px; }
  .cal { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(10px, 1fr); gap: 3px; min-width: 640px; }
  .wk { display: grid; grid-template-rows: repeat(7, 1fr); gap: 3px; align-content: start; }
  .cal i { display: block; aspect-ratio: 1; border-radius: 3px; background: var(--pill); border: 1px solid var(--pillb); transition: transform .4s var(--spring); }
  .cal i:hover { transform: scale(1.6); position: relative; z-index: 1; }
  .cal .l1 { background: color-mix(in srgb, var(--accent2) 30%, var(--bg)); border-color: transparent; }
  .cal .l2 { background: color-mix(in srgb, var(--accent2) 55%, var(--bg)); border-color: transparent; }
  .cal .l3 { background: color-mix(in srgb, var(--accent2) 80%, var(--bg)); border-color: transparent; }
  .cal .l4 { background: var(--accent2); border-color: transparent; }
  h3 { font: 700 16px var(--sans); margin: 36px 0 12px; }
  .bar { display: flex; height: 12px; border-radius: 999px; overflow: hidden; gap: 2px; }
  .legend { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 15px; font-weight: 600; }
  .legend li { display: inline-flex; align-items: center; gap: 8px; }
  .legend i { width: 10px; height: 10px; border-radius: 50%; }
  .legend span { color: var(--mute); font-weight: 500; }
  .note { color: var(--mute); font-size: 14px; margin: 18px 0 0; }
</style>
