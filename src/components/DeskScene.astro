---
// Illustrated header: the desk is the identity. Lamp and theme button flip day/night; the cha glass takes sips.
---
<header class="scene">
  <svg class="land" viewBox="0 0 1440 320" preserveAspectRatio="xMidYMax slice" role="img" aria-label="A desk with a laptop, a glass of cha, a notebook and a lamp by a window">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--sky1)" /><stop offset="1" stop-color="var(--sky2)" /></linearGradient>
      <linearGradient id="cone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd98a" stop-opacity=".55" /><stop offset="1" stop-color="#ffd98a" stop-opacity="0" /></linearGradient>
      <clipPath id="win"><rect x="1000" y="40" width="250" height="160" rx="4" /></clipPath>
      <clipPath id="glass"><path d="M900 174h48l-6 72h-36z" /></clipPath>
    </defs>

    <!-- window: sky, sun/moon, a coconut palm -->
    <g clip-path="url(#win)">
      <rect x="1000" y="40" width="250" height="160" fill="url(#sky)" />
      <g class="stars" fill="#fff"><circle cx="1030" cy="64" r="1.5" /><circle cx="1090" cy="56" r="1" /><circle cx="1150" cy="80" r="1.5" /><circle cx="1210" cy="60" r="1" /><circle cx="1060" cy="100" r="1" /></g>
      <circle cx="1190" cy="86" r="18" fill="var(--sun)" />
      <g fill="var(--far)">
        <path d="M1060 200c4-40 8-70 6-96h6c2 26 0 56-4 96z" />
        <path d="M1068 106c-30-6-50 6-62 22 22-12 40-14 62-16zM1070 104c26-14 52-12 70 2-24-4-46-2-68 4zM1068 104c-10-24-30-34-50-34 18 8 32 20 44 38zM1072 104c12-22 30-30 52-28-20 6-36 16-48 32z" />
        <path d="M1000 200c40-24 90-30 140-20s80 6 110-6v26z" />
      </g>
    </g>
    <rect x="1000" y="40" width="250" height="160" rx="4" fill="none" stroke="var(--frame)" stroke-width="10" />
    <path d="M1125 40v160M1000 120h250" stroke="var(--frame)" stroke-width="6" />
    <rect x="990" y="198" width="270" height="10" rx="3" fill="var(--frame)" />

    <!-- shelf -->
    <rect x="120" y="104" width="250" height="9" rx="3" fill="var(--wood)" />
    <rect x="140" y="58" width="16" height="46" rx="2" fill="#e5484d" /><rect x="158" y="64" width="14" height="40" rx="2" fill="#3e9fe0" /><rect x="174" y="54" width="18" height="50" rx="2" fill="#f5c542" /><rect x="194" y="66" width="12" height="38" rx="2" fill="#4caf7a" /><rect x="214" y="72" width="40" height="12" rx="2" fill="#a774e8" transform="rotate(-24 214 84)" />
    <path d="M318 104h34l-4-26h-26z" fill="#d07a4f" /><path d="M335 78c-2-16 2-28 0-38 6 10 10 22 6 38zM330 80c-10-8-14-18-12-26 6 6 10 14 12 26z" fill="#4caf7a" />

    <g class="lamp" data-flip role="button" tabindex="0" aria-label="Lamp: switch between day and night">
      <path class="beam" d="M402 126L340 246h190L452 126z" fill="url(#cone)" />
      <rect x="388" y="236" width="70" height="10" rx="5" fill="var(--near)" />
      <path d="M420 236l-8-70 46-44" stroke="var(--near)" stroke-width="7" fill="none" stroke-linecap="round" />
      <path class="shade" d="M432 108l46 18-14 22-44-22z" fill="var(--accent)" />
      <circle cx="442" cy="140" r="5" fill="var(--bulb)" />
    </g>

    <rect x="0" y="246" width="1440" height="12" fill="var(--wood)" />
    <rect x="0" y="258" width="1440" height="26" fill="var(--wood2)" />

    <!-- laptop with code typing itself -->
    <rect x="540" y="100" width="300" height="146" rx="12" fill="var(--near)" />
    <rect x="554" y="114" width="272" height="118" rx="5" fill="#0f1420" />
    <g class="code" stroke-linecap="round" stroke-width="6" fill="none">
      <path pathLength="1" d="M574 136h50" stroke="#ff5c93" /><path pathLength="1" d="M634 136h80" stroke="#7fb0ff" />
      <path pathLength="1" d="M594 156h110" stroke="#9fd88a" /><path pathLength="1" d="M594 176h56" stroke="#f5c542" />
      <path pathLength="1" d="M660 176h70" stroke="#7fb0ff" /><path pathLength="1" d="M594 196h86" stroke="#c9a7ff" />
      <path pathLength="1" d="M574 216h30" stroke="#ff5c93" />
    </g>
    <rect class="caret" x="612" y="208" width="4" height="16" fill="#fff" />
    <path d="M500 246h380l-22-10H522z" fill="var(--near)" />

    <g class="cha" role="button" tabindex="0" aria-label="Glass of cha: take a sip">
      <g class="steam" stroke="var(--steam)" stroke-width="3" fill="none" stroke-linecap="round"><path d="M914 166c-8-12 8-18 0-30" /><path d="M932 166c-8-12 8-18 0-30" /></g>
      <rect class="tea" clip-path="url(#glass)" x="896" y="182" width="56" height="70" fill="#c9852d" />
      <path class="glass" d="M900 174h48l-6 72h-36z" fill="#ffffff22" stroke="var(--glassline)" stroke-width="2.5" />
      <ellipse cx="924" cy="248" rx="34" ry="4" fill="#00000022" />
    </g>

    <!-- khata and pen -->
    <path d="M980 244l20-22h128l-20 22z" fill="var(--paper)" />
    <path d="M1012 222l-20 22" stroke="#e5484d" stroke-width="2" />
    <path d="M1010 230h96M1004 237h96" stroke="var(--rule)" stroke-width="1.5" />
    <path d="M1060 226l50-12" stroke="var(--near)" stroke-width="5" stroke-linecap="round" />

    <path d="M1300 246h52l6-40h-64z" fill="#3e9fe0" />
    <path d="M1326 206c-4-30 10-52 30-62-14 18-20 38-24 62zM1322 206c-16-20-36-26-52-22 20 4 36 12 46 24zM1326 206c4-20 0-44-10-60 16 14 20 36 16 60z" fill="#4caf7a" />

    <rect y="284" width="1440" height="36" fill="var(--bg)" />
  </svg>

  <nav aria-label="Main">
    <div class="w bar">
      <a class="logo" href="#top">arafat<span>.</span></a>
      <div class="right">
        <ul>
          <li><a href="#work">Work</a></li>
          <li class="opt"><a href="#stack">Stack</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
        <button class="tog" data-flip type="button" aria-label="Switch between light and dark theme">
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<style>
  /* the nav gets its own 72px band of wall so it never sits on the illustration */
  .scene { position: relative; height: calc(clamp(140px, 22.2vw, 420px) + 72px); background: linear-gradient(var(--wall1), var(--wall2)); overflow: hidden; }
  .land { position: absolute; inset: auto 0 -1px 0; width: 100%; height: calc(100% - 72px); }
  .stars { opacity: var(--stars); transition: opacity .6s; }
  .beam { opacity: var(--beam); transition: opacity .5s; }
  .lamp, .cha { cursor: pointer; outline: none; }
  .lamp:focus-visible .shade, .cha:focus-visible .glass { stroke: var(--accent2); stroke-width: 3; }
  .tea { transition: transform .6s var(--spring); }
  .code path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: type 7s ease infinite; }
  .code path:nth-child(2) { animation-delay: .5s; } .code path:nth-child(3) { animation-delay: 1s; }
  .code path:nth-child(4) { animation-delay: 1.5s; } .code path:nth-child(5) { animation-delay: 2s; }
  .code path:nth-child(6) { animation-delay: 2.5s; } .code path:nth-child(7) { animation-delay: 3s; }
  @keyframes type { 0% { stroke-dashoffset: 1; } 12%, 85% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  .caret { animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .steam path { animation: rise 2.4s ease-in-out infinite; }
  .steam path + path { animation-delay: -1.2s; }
  @keyframes rise { 0% { transform: translateY(6px); opacity: 0; } 40% { opacity: .9; } 100% { transform: translateY(-14px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .code path { stroke-dashoffset: 0; } }

  nav { position: absolute; inset: 0 0 auto; z-index: 2; color: var(--navink); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 22px; }
  .logo { font: 800 22px var(--sans); text-decoration: none; }
  .logo span { color: var(--accent); }
  .right { display: flex; align-items: center; gap: 18px; }
  ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; font-weight: 600; font-size: 16px; }
  ul a { text-decoration: none; }
  ul a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .tog { all: unset; cursor: pointer; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; transition: transform .6s var(--spring); }
  .tog:hover { transform: rotate(25deg) scale(1.1); }
  .tog:focus-visible { outline: 2px solid var(--accent2); }
  .tog svg { grid-area: 1 / 1; width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .sun { display: none; }
  :global([data-theme="dark"]) .sun { display: block; }
  :global([data-theme="dark"]) .moon { display: none; }
  @media (max-width: 800px) { ul { gap: 16px; font-size: 15px; } }
  @media (max-width: 480px) { .opt { display: none; } }
</style>

<script>
  const root = document.documentElement;
  const flip = () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
  };
  const onActivate = (el: Element, fn: () => void) => {
    el.addEventListener('click', fn);
    el.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (el.tagName !== 'BUTTON' && (k === 'Enter' || k === ' ')) { e.preventDefault(); fn(); }
    });
  };
  document.querySelectorAll('[data-flip]').forEach((el) => onActivate(el, flip));

  const tea = document.querySelector<SVGRectElement>('.tea');
  let sips = 0;
  const cha = document.querySelector('.cha');
  if (cha && tea) onActivate(cha, () => { sips = (sips + 1) % 4; tea.style.transform = `translateY(${sips * 16}px)`; });
</script>
