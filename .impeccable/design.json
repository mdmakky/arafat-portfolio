  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid ink button for the live link on project pages.",
      "html": "<a class=\"ds-btn\" href=\"#\">Visit the live app <svg class=\"ds-arrow\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:10px;background:var(--fg);color:var(--bg);text-decoration:none;font:700 15px var(--sans);transition:transform .5s var(--spring)}.ds-btn:hover{transform:translateY(-2px)}.ds-btn:hover .ds-arrow{transform:translateX(5px)}.ds-btn:focus-visible{outline:2px solid var(--accent2);outline-offset:3px}.ds-arrow{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;transition:transform .5s var(--spring)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Tinted secondary button for the source-code link.",
      "html": "<a class=\"ds-btn-ghost\" href=\"#\">Source code <svg class=\"ds-arrow\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:10px;background:var(--pill);color:var(--fg);border:1px solid var(--pillb);text-decoration:none;font:700 15px var(--sans);transition:transform .5s var(--spring)}.ds-btn-ghost:hover{transform:translateY(-2px)}.ds-btn-ghost:hover .ds-arrow{transform:translateX(5px)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent2);outline-offset:3px}.ds-arrow{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;transition:transform .5s var(--spring)}"
    },
    {
      "name": "Arrow Link",
      "kind": "custom",
      "description": "Onward link with a trailing line arrow that springs right on hover.",
      "html": "<a class=\"ds-more\" href=\"#\">How I built it <svg class=\"ds-arrow\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg></a>",
      "css": ".ds-more{font:700 15px var(--sans);color:var(--fg);text-decoration:none;display:inline-flex;gap:6px;align-items:center}.ds-more:hover{color:var(--accent2)}.ds-more:hover .ds-arrow{transform:translateX(5px)}.ds-more:focus-visible{outline:2px solid var(--accent2);outline-offset:3px;border-radius:4px}.ds-arrow{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;transition:transform .5s var(--spring)}"
    },
    {
      "name": "Stack Pills",
      "kind": "chip",
      "refersTo": "pill-tag",
      "description": "Display-only stack tags that tilt on hover.",
      "html": "<ul class=\"ds-pills\"><li>Node.js</li><li>FastAPI</li><li>PostgreSQL</li><li>Flutter</li></ul>",
      "css": ".ds-pills{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}.ds-pills li{font:500 14px var(--sans);color:var(--fg);padding:4px 12px;border-radius:8px;background:var(--pill);border:1px solid var(--pillb);transition:transform .45s var(--spring)}.ds-pills li:hover{transform:translateY(-3px) rotate(-2deg)}"
    },
    {
      "name": "Status Card",
      "kind": "card",
      "refersTo": "status-card",
      "description": "Tinted card for the open-to-work note.",
      "html": "<div class=\"ds-now\"><span class=\"ds-dot\"></span><b>Open to work.</b> Looking for Junior SWE and backend roles.</div>",
      "css": ".ds-now{background:var(--pill);border:1px solid var(--pillb);border-radius:14px;padding:18px 20px;color:var(--soft);font:16px/1.65 var(--sans)}.ds-now b{color:var(--fg)}.ds-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#22c55e;margin-right:8px}"
