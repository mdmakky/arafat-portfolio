      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 20px;color:var(--navink);background:linear-gradient(var(--wall1),var(--wall2))}.ds-logo{font:800 22px var(--sans);color:inherit;text-decoration:none}.ds-logo span{color:var(--accent)}.ds-nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0;font:600 16px var(--sans)}.ds-nav ul a{color:inherit;text-decoration:none}.ds-nav ul a:hover{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:6px}.ds-nav a:focus-visible{outline:2px solid var(--accent2);outline-offset:3px;border-radius:4px}"
